{
  "name": "claude-kit-tests",
  "private": true,
  "scripts": {
    "test": "bun test tests/static tests/stories tests/fixtures tests/utils",
    "test:evals:smoke": "EVAL_TIER=smoke bun test tests/evals/activation.test.ts --timeout 120000",
    "test:evals": "EVAL_TIER=full bun test tests/evals --concurrent --max-concurrency 4 --timeout 120000",
    "test:evals:parity": "EVAL_TIER=parity HARNESSES=omp bun test tests/evals/activation.test.ts --concurrent --max-concurrency 4 --timeout 120000",
    "test:all": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/mdast": "^4",
    "@types/unist": "^3",
    "yaml": "^2",
    "unified": "^11",
    "remark-parse": "^11"
  }
}
